package {{ .Package }}

import (
{{- if .NeedsTimeImport }}
	"time"

{{ end }}
{{- if .ModelImport }}
	"{{ .ModelImport }}"

{{ end }}
	"github.com/devituz/lagodev/database"
	"github.com/devituz/lagodev/factory"
)

// Usage: factories.{{ .Name }}(conn).Count(10).Create(ctx)
func {{ .Name }}(conn *database.Connection) *factory.Factory[{{ .ModelRef }}] {
	return factory.New(conn, func(f *factory.Faker) {{ .ModelRef }} {
		return {{ .ModelRef }}{
{{- range .Fields }}
			{{ .FieldName }}: {{ .FakerCall }},
{{- end }}
		}
	})
}
