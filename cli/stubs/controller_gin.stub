package {{ .Package }}

import (
{{- if .ModelImport }}
	"{{ .ModelImport }}"
{{ end }}
{{- if .ServiceImport }}

	"{{ .ServiceImport }}"
{{ end }}

	"github.com/devituz/lagodev/database"
	lagogin "github.com/devituz/lagodev/adapters/gin"
)

// {{ .Name }} — {{ .ModelRef }} resursi uchun Gin RESTful handler'lar.
// Har bir metod (any, error) qaytaradi — lagogin.H avtomat status mapping
// qiladi: orm.ErrNotFound → 404, validation.Error → 422, qolgani → 500.
type {{ .Name }} struct {
	Service *{{ .ServiceRef }}
}

// New{{ .Name }} — service'ni biriktirilgan ulanish bilan quradi.
func New{{ .Name }}(conn *database.Connection) *{{ .Name }} {
	return &{{ .Name }}{Service: {{ .ServiceConstructor }}(conn)}
}

// Index — GET /{{ .Resource }} — sahifalangan ro'yxat.
func (c *{{ .Name }}) Index(ctx *lagogin.Ctx) (any, error) {
	return lagogin.Paginate[{{ .ModelRef }}](ctx, c.Service.Query().OrderBy("id", "desc"))
}

// Show — GET /{{ .Resource }}/:id — bitta yozuv.
func (c *{{ .Name }}) Show(ctx *lagogin.Ctx) (any, error) {
	return c.Service.Get(ctx.Ctx(), ctx.ParamUint("id"))
}

// Store — POST /{{ .Resource }} — yangi yozuv yaratish.
func (c *{{ .Name }}) Store(ctx *lagogin.Ctx) (any, error) {
	var item {{ .ModelRef }}
	if err := ctx.BindAndValidate(&item); err != nil {
		return nil, err
	}
	if err := c.Service.Create(ctx.Ctx(), &item); err != nil {
		return nil, err
	}
	return ctx.Created(item), nil
}

// Update — PUT/PATCH /{{ .Resource }}/:id — yozuvni yangilash.
func (c *{{ .Name }}) Update(ctx *lagogin.Ctx) (any, error) {
	existing, err := c.Service.Get(ctx.Ctx(), ctx.ParamUint("id"))
	if err != nil {
		return nil, err
	}
	if err := ctx.Bind(existing); err != nil {
		return nil, err
	}
	if err := lagogin.Validate(existing); err != nil {
		return nil, err
	}
	return existing, c.Service.Update(ctx.Ctx(), existing)
}

// Destroy — DELETE /{{ .Resource }}/:id — yozuvni soft-delete qilish.
func (c *{{ .Name }}) Destroy(ctx *lagogin.Ctx) (any, error) {
	item, err := c.Service.Get(ctx.Ctx(), ctx.ParamUint("id"))
	if err != nil {
		return nil, err
	}
	return nil, c.Service.Delete(ctx.Ctx(), item)
}
