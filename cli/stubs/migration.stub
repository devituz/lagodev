package {{ .Package }}

import (
	"github.com/devituz/lagodev/migrations"
	"github.com/devituz/lagodev/schema"
)

func init() {
	migrations.Register(migrations.Define(
		"{{ .Name }}",
		func(ctx *migrations.Context) error {
			return ctx.Schema(schema.Create("{{ .Table }}", func(t *schema.Blueprint) {
				t.ID()
{{- range .Fields }}
				{{ .MigrationCall }}
{{- end }}
				t.Timestamps()
			}))
		},
		func(ctx *migrations.Context) error {
			return ctx.Schema(schema.DropIfExists("{{ .Table }}"))
		},
	))
}
